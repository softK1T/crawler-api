API_HOST=0.0.0.0
API_PORT=8000

# REQUIRED — no default. Set to a comma-separated list of valid API keys.
# Each key should start with crw_live_ or crw_test_ prefix.
# Leave empty to disable auth (dev/local only).
API_KEYS_RAW=

# REQUIRED — no default. CORS allowed origins as comma-separated list.
# Example: http://localhost:3000,https://app.example.com
# Defaults to "*" if not set (dev convenience; restrict in production).
ALLOWED_ORIGINS_RAW=*

# REQUIRED — no default. PostgreSQL connection string.
# Example: postgresql+asyncpg://user:pass@localhost:5432/crawlerdb
DATABASE_URL=postgresql+asyncpg://user:changeme@localhost:5432/crawlerdb

# Redis (local dev defaults — no credentials needed)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/2

# Crawler settings
PROXY_FILE=
MAX_RETRIES=3
REQUEST_TIMEOUT_SECS=15
REQUEST_DELAY_SECS=1.0
USE_HTTP2=true
SSRF_ENABLED=true

# Storage TTL for Redis cache (seconds)
RESULT_TTL_SECS=86400

# Key rotation overlap window in hours — old key remains valid for this
# duration after rotation so clients have time to swap (ADR-016 D4).
KEY_ROTATION_OVERLAP_HOURS=24

# -----------------------------------------------
# Webshare.io auto-sync (recommended)
# Get your API key: https://proxy.webshare.io/userapi/keys
# -----------------------------------------------
# Your Webshare API token
WEBSHARE_API_KEY=
# File where synced proxies will be written (format: host:port:user:pass:COUNTRY)
WEBSHARE_PROXY_FILE=proxies.txt
# Re-sync interval in seconds (default: 21600 = 6 hours)
WEBSHARE_SYNC_INTERVAL_SECS=21600
