# ── Server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Security ─────────────────────────────────────────────
# Comma-separated list of valid API keys.
# Leave empty to disable auth (development / local only).
# Example: API_KEYS_RAW=supersecret-key-1,another-key-2
API_KEYS_RAW=

# Set to false ONLY in fully trusted internal environments.
SSRF_ENABLED=true

# ── Redis / Celery ───────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/2
RESULT_TTL_SECS=86400

# ── Crawler ──────────────────────────────────────────────
PROXY_FILE=proxies.txt
MAX_RETRIES=3
REQUEST_TIMEOUT_SECS=15
REQUEST_DELAY_SECS=1.0
USE_HTTP2=true

# ── Batch ────────────────────────────────────────────────
MAX_BATCH_SIZE=1000
BATCH_TIMEOUT_SECS=900
