API_HOST=0.0.0.0
API_PORT=8000

# Leave empty to disable auth in dev
API_KEYS_RAW=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://crawler:crawler@localhost:5432/crawlerdb

# Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/2

# Crawler settings
PROXY_FILE=
MAX_RETRIES=3
REQUEST_TIMEOUT_SECS=15
REQUEST_DELAY_SECS=1.0
USE_HTTP2=true
SSRF_ENABLED=true

# Storage TTL for Redis cache (seconds)
RESULT_TTL_SECS=86400

# -----------------------------------------------
# Webshare.io auto-sync (recommended)
# Get your API key: https://proxy.webshare.io/userapi/keys
# -----------------------------------------------
# Your Webshare API token
WEBSHARE_API_KEY=
# File where synced proxies will be written (format: host:port:user:pass:COUNTRY)
WEBSHARE_PROXY_FILE=proxies.txt
# Re-sync interval in seconds (default: 21600 = 6 hours)
WEBSHARE_SYNC_INTERVAL_SECS=21600
